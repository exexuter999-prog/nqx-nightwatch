# R18 dayguard defaults. Copy values into the runtime environment only after review.
# First install only: verify there is no historical ledger to recover, then run:
#   python dayguard.py --initialize
# A missing ledger after this marker exists is DAYGUARD_UNAVAILABLE; do not recreate it blindly.
NQX_DAYGUARD=on
# R40 LTA A/B mirrored: one max-risk signal is -$480 aggregate; two losses stop at -$960.
NQX_DAY_LOSS_LIMIT=-960
NQX_CONSEC_LOSS_LIMIT=2
NQX_COOLDOWN_MIN=15
NQX_DAY_BOUNDARY_H=7

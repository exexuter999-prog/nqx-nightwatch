//@version=6
// WARMUP AUDIT: dailyAtr14=1D (request.security, confirmed[1]+lookahead_on, never warmed on intraday bars)
// WARMUP AUDIT: relVolume baseline=30m-of-day rolling mean over 14 prior sessions (built from confirmed intraday accumulation, not daily-TF indicator)
//
// NQX Evidence-Based Strategy Upgrade — M1: Opening Range Breakout verification harness.
// This is a STRATEGY TESTER file. It is not the production indicator and never
// writes to Nightwatch/NQX JSON. See project/indicator/NQX_EVIDENCE_BASED_STRATEGY_UPGRADE_BLUEPRINT.md
// and project/strategy/GPT_STRATEGY_UPGRADE_DIRECTIVE.md for the governing design.
//
// PAST PERFORMANCE IS NOT A GUARANTEE OF FUTURE RESULTS. No number produced by
// this file may be declared "good PF" without passing J-5 (IS/OOS/CI/robustness)
// and without the ZERO cost profile being excluded from any declaration.
strategy("NQX BT — M1 Opening Range Breakout", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 1.00, slippage = 1, calc_on_every_tick = false, process_orders_on_close = false)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
string GROUP_COST   = "01 · COST MODEL"
string GROUP_WINDOW = "02 · SAMPLE WINDOW"
string GROUP_ORB    = "03 · ORB RULES"
string GROUP_GATE   = "04 · REGIME GATES"
string GROUP_STRUCT = "05 · STRUCTURE GATE (R-D)"

// Cost is switched by input, never silently zero. ZERO exists for diagnostic
// use only and must never be used as the basis of a PF declaration (blueprint J-3).
string costProfile = input.string("BASELINE", "Cost profile", options = ["ZERO", "BASELINE", "STRESS"], group = GROUP_COST, tooltip = "ZERO = reference only, never usable for a PF declaration. BASELINE = $1.00 commission/side + 1 tick slippage ($3.00 RT). STRESS variant requires a separate compile with commission_value=1.24/slippage=2 per J-3 — this input only documents intent in the label and RESULTS export; it cannot rewrite the strategy() declaration at runtime.")

string sampleWindow = input.string("IS", "Sample window", options = ["IS", "OOS", "FWD", "ALL"], group = GROUP_WINDOW, tooltip = "IS=2016-01-01..2022-12-31. OOS=2023-01-01..2025-12-31 (do not open before candidate clears IS gate — J-5/no peeking). FWD=from run date forward (paper). ALL=no filter, diagnostic only.")

int orMinutes = input.int(5, "OR window (minutes)", options = [5, 15, 30], group = GROUP_ORB)
string tradeDirection = input.string("both", "Trade direction", options = ["both", "long_only", "short_only"], group = GROUP_ORB)
string stopMode = input.string("OR_OPPOSITE", "Stop mode", options = ["OR_OPPOSITE", "ATR_FRACTION"], group = GROUP_ORB)
float atrStopFraction = input.float(0.10, "ATR stop fraction (ATR_FRACTION mode)", minval = 0.02, maxval = 1.0, step = 0.01, group = GROUP_ORB)
int dailyAtrLength = input.int(14, "Daily ATR length (warm-up audited)", minval = 2, maxval = 60, group = GROUP_ORB)

bool useRegimeA = input.bool(false, "R-A: session window gate (09:30-11:30 ET)", group = GROUP_GATE)
bool useRegimeB = input.bool(false, "R-B: relative volume gate", group = GROUP_GATE)
float relVolumeThreshold = input.float(1.2, "R-B relative volume threshold", minval = 1.0, maxval = 2.0, step = 0.1, group = GROUP_GATE)
bool useRegimeD = input.bool(false, "R-D: SwingArm CT direction agreement (M1-05 Structure synthesis)", group = GROUP_STRUCT)
int structLength = input.int(28, "R-D CT ATR length (mirrors V2 default)", minval = 2, maxval = 200, group = GROUP_STRUCT)
float structFactor = input.float(5.0, "R-D CT ATR factor (mirrors V2 default)", minval = 0.1, maxval = 20.0, step = 0.1, group = GROUP_STRUCT)

// ─────────────────────────────────────────────────────────────────────────────
// Sample window filter (IS/OOS/FWD/ALL) — time-based, no lookahead risk since
// `time` on the confirmed bar is always known at that bar.
// ─────────────────────────────────────────────────────────────────────────────
int isStart  = timestamp("America/New_York", 2016, 1, 1, 0, 0)
int isEnd    = timestamp("America/New_York", 2022, 12, 31, 23, 59)
int oosStart = timestamp("America/New_York", 2023, 1, 1, 0, 0)
int oosEnd   = timestamp("America/New_York", 2025, 12, 31, 23, 59)

bool inSampleWindow = sampleWindow == "ALL" ? true : sampleWindow == "IS" ? (time >= isStart and time <= isEnd) : sampleWindow == "OOS" ? (time >= oosStart and time <= oosEnd) : time > oosEnd

// ─────────────────────────────────────────────────────────────────────────────
// RTH session detection (explicit America/New_York, never chart-TZ dependent)
// ─────────────────────────────────────────────────────────────────────────────
bool inRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
bool isOrWindow = not na(time(timeframe.period, orMinutes == 5 ? "0930-0935" : orMinutes == 15 ? "0930-0945" : "0930-1000", "America/New_York"))
bool isSessionStart = inRth and not inRth[1]
bool forceFlatWindow = not na(time(timeframe.period, "1555-1600", "America/New_York"))

// R-A: 09:30-11:30 ET entry window (blueprint 5-3 R-A default)
bool regimeAWindow = not na(time(timeframe.period, "0930-1130", "America/New_York"))

// ─────────────────────────────────────────────────────────────────────────────
// Opening range accumulation. State resets on new RTH session. Only confirmed
// bars mutate state (no intrabar repaint of the OR box).
// ─────────────────────────────────────────────────────────────────────────────
var float orHigh = na
var float orLow = na
var bool orLocked = false
var int orFirstBarVolume = na
var float orVolumeSum = na
var int orBarCount = 0

if barstate.isconfirmed
    if isSessionStart
        orHigh := high
        orLow := low
        orLocked := false
        orVolumeSum := volume
        orBarCount := 1
    else if inRth and isOrWindow and not orLocked
        orHigh := math.max(orHigh, high)
        orLow := math.min(orLow, low)
        orVolumeSum := nz(orVolumeSum) + volume
        orBarCount := orBarCount + 1
    else if inRth and not isOrWindow and not orLocked
        orLocked := true

bool orReady = orLocked and not na(orHigh) and not na(orLow)

// ─────────────────────────────────────────────────────────────────────────────
// R-B relative volume: opening-window volume vs. the same time-of-day mean
// over the trailing 14 RTH sessions. Built from confirmed daily aggregates,
// not warmed on intraday bars (WARMUP AUDIT above).
// ─────────────────────────────────────────────────────────────────────────────
var array<float> orVolumeHistory = array.new<float>()
var float orVolumeBaseline = na
bool orJustLocked = orLocked and not orLocked[1]
if barstate.isconfirmed and orJustLocked and not na(orVolumeSum)
    array.push(orVolumeHistory, orVolumeSum)
    if array.size(orVolumeHistory) > 14
        array.shift(orVolumeHistory)
    if array.size(orVolumeHistory) >= 5
        float total = 0.0
        for i = 0 to array.size(orVolumeHistory) - 1
            total += array.get(orVolumeHistory, i)
        orVolumeBaseline := total / array.size(orVolumeHistory)

float relativeVolume = not na(orVolumeBaseline) and orVolumeBaseline > 0 and not na(orVolumeSum) ? orVolumeSum / orVolumeBaseline : na
bool regimeBPass = not useRegimeB or (not na(relativeVolume) and relativeVolume >= relVolumeThreshold)

// ─────────────────────────────────────────────────────────────────────────────
// Daily ATR(14) for the ATR_FRACTION stop variant. Requested on the daily
// timeframe series itself — never accumulated from intraday bars — using the
// same confirmed[1] + lookahead_on convention as the production V2 engine.
// ─────────────────────────────────────────────────────────────────────────────
f_dailyAtr(int _length) =>
    ta.atr(_length)

dailyAtrRaw = request.security(syminfo.tickerid, "1D", f_dailyAtr(dailyAtrLength), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float dailyAtr = dailyAtrRaw[1]

// ─────────────────────────────────────────────────────────────────────────────
// R-D Structure gate: recompute the CT SwingArm direction in-strategy (does
// not reference the production indicator — clean-room per directive 1 §Change-
// prohibited files). Mirrors f_engineSeries's ATR-trail core only.
// ─────────────────────────────────────────────────────────────────────────────
f_ctTrendOnly(int _length, float _factor) =>
    float barRange = high - low
    float trueRange = math.max(barRange, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    float wildAtr = 0.0
    wildAtr := barstate.isconfirmed ? nz(wildAtr[1]) + (trueRange - nz(wildAtr[1])) / _length : nz(wildAtr[1])
    float loss = _factor * wildAtr
    float upCandidate = close - loss
    float downCandidate = close + loss
    float trendUp = upCandidate
    trendUp := barstate.isconfirmed ? (close[1] > trendUp[1] ? math.max(upCandidate, trendUp[1]) : upCandidate) : nz(trendUp[1], upCandidate)
    float trendDown = downCandidate
    trendDown := barstate.isconfirmed ? (close[1] < trendDown[1] ? math.min(downCandidate, trendDown[1]) : downCandidate) : nz(trendDown[1], downCandidate)
    int trend = 1
    trend := barstate.isconfirmed ? (close > trendDown[1] ? 1 : close < trendUp[1] ? -1 : nz(trend[1], 1)) : nz(trend[1], 1)
    trend

int ctStructureTrend = f_ctTrendOnly(structLength, structFactor)
bool regimeDPass = not useRegimeD or ctStructureTrend == 1 or ctStructureTrend == -1 // direction match checked per-side below

// ─────────────────────────────────────────────────────────────────────────────
// Entry logic — confirmed-bar breakout of the locked OR box. Entry fires on
// the CLOSE of the breakout bar; execution is the OPEN of the next bar
// (process_orders_on_close=false default — no same-bar-close fill assumed).
// ─────────────────────────────────────────────────────────────────────────────
var bool tradedToday = false
bool newDay = isSessionStart
if barstate.isconfirmed and newDay
    tradedToday := false

bool regimeAPass = not useRegimeA or regimeAWindow
bool longStructOk = not useRegimeD or ctStructureTrend == 1
bool shortStructOk = not useRegimeD or ctStructureTrend == -1

bool longBreakout = barstate.isconfirmed and orReady and inRth and not tradedToday and close > orHigh and close[1] <= orHigh and regimeAPass and regimeBPass and longStructOk and (tradeDirection == "both" or tradeDirection == "long_only")
bool shortBreakout = barstate.isconfirmed and orReady and inRth and not tradedToday and close < orLow and close[1] >= orLow and regimeAPass and regimeBPass and shortStructOk and (tradeDirection == "both" or tradeDirection == "short_only")

float longStop = stopMode == "OR_OPPOSITE" ? orLow : (not na(dailyAtr) ? close - atrStopFraction * dailyAtr : na)
float shortStop = stopMode == "OR_OPPOSITE" ? orHigh : (not na(dailyAtr) ? close + atrStopFraction * dailyAtr : na)

if inSampleWindow and longBreakout and not na(longStop)
    strategy.entry("ORB_LONG", strategy.long)
    tradedToday := true
if inSampleWindow and shortBreakout and not na(shortStop)
    strategy.entry("ORB_SHORT", strategy.short)
    tradedToday := true

// Stops are re-issued on every confirmed bar while a position is open so the
// OR-locked levels (fixed at entry) remain attached across the session.
var float activeLongStop = na
var float activeShortStop = na
if barstate.isconfirmed
    if longBreakout
        activeLongStop := longStop
    if shortBreakout
        activeShortStop := shortStop
    if strategy.position_size <= 0
        activeLongStop := na
    if strategy.position_size >= 0
        activeShortStop := na

if strategy.position_size > 0 and not na(activeLongStop)
    strategy.exit("ORB_LONG_X", "ORB_LONG", stop = activeLongStop)
if strategy.position_size < 0 and not na(activeShortStop)
    strategy.exit("ORB_SHORT_X", "ORB_SHORT", stop = activeShortStop)

// Forced EOD flat at 15:55 ET regardless of stop state (basic form has no target).
if barstate.isconfirmed and forceFlatWindow and strategy.position_size != 0
    strategy.close_all("EOD_FLAT")

// ─────────────────────────────────────────────────────────────────────────────
// Plots — kept minimal (strategy files are measurement instruments, not the
// production display). Output series budget: 6 (well under the 40 cap, J-2).
// ─────────────────────────────────────────────────────────────────────────────
plot(orReady ? orHigh : na, "OR High", color = color.new(color.lime, 40), style = plot.style_stepline)
plot(orReady ? orLow : na, "OR Low", color = color.new(color.red, 40), style = plot.style_stepline)
plot(useRegimeD ? (ctStructureTrend == 1 ? high : low) : na, "R-D structure marker", color = color.new(color.blue, 70), style = plot.style_circles)
plot(dailyAtr, "Daily ATR14 (diagnostic)", display = display.data_window)
plot(relativeVolume, "Relative volume (diagnostic)", display = display.data_window)
plot(costProfile == "ZERO" ? 1 : 0, "ZERO cost profile active (diagnostic-only, never declare from this)", display = display.data_window)

// OUTPUT SERIES COUNT: 6 plots total (2 visible OR lines, 1 marker, 3 data-window diagnostics).
